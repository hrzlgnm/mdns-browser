{
    "identifier": "mobile",
    "description": "permissions for mobile",
    "local": true,
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:app:allow-set-app-theme",
        "core:window:allow-set-theme",
        "clipboard-manager:allow-write-text",
        "opener:allow-open-url",
        "opener:allow-default-urls",
        "store:default",
        "android-update:default",
        "log:default"
    ],
    "platforms": [
        "android"
    ]
}
