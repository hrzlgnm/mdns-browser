{
  "name": "mdns-browser-frontend",
  "version": "2.4.0",
  "description": "SvelteKit frontend for mdns-browser",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "svelte-kit sync && vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "svelte-kit sync && eslint src",
    "lint:fix": "svelte-kit sync && eslint src --fix",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "tauri-plugin-android-update-api": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/mdi": "1.2.3",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
