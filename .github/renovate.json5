{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        "config:best-practices",
        "monorepo:tauri",
        "security:openssf-scorecard",
        ":automergeDigest",
        ":automergeMinor",
        ":automergePr",
        ":automergeRequireAllStatusChecks",
        ":combinePatchMinorReleases",
        ":docker",
        ":enableVulnerabilityAlerts",
        ":maintainLockFilesWeekly",
        ":prConcurrentLimitNone",
        ":prImmediately",
        ":rebaseStalePrs",
        ":semanticCommits",
        ":separateMajorReleases",
    ],
    customManagers: [
        {
            matchStringsStrategy: 'any',
            customType: 'regex',
            managerFilePatterns: [
                '/^\\.github/workflows/.*\\.yml$/',
            ],
            depTypeTemplate: 'container',
            datasourceTemplate: 'docker',
            versioningTemplate: 'docker',
            matchStrings: [
                'container_image: (?<depName>.*):(?<currentValue>.*?)@(?<currentDigest>sha256:[a-f0-9]+)?'
            ],
            autoReplaceStringTemplate: 'container_image: {{depName}}{{#if newValue}}:{{newValue}}{{/if}}{{#if newDigest}}@{{newDigest}}{{/if}}',
        },
        {
            matchStringsStrategy: "any",
            customType: "regex",
            managerFilePatterns: [
                "/^\\.github/workflows/.*\\.yml$/",
                "/^\\.github/actions/.*/.*\\.yml$/",
            ],
            matchStrings: [
                "crate:\\s*(?<depName>[^\\s]+)\\s*version:\\s*(?<currentValue>[^\\s]+)",
            ],
            depTypeTemplate: "build-dependencies",
            datasourceTemplate: "crate",
            versioningTemplate: "semver",
        },
        {
            matchStringsStrategy: "any",
            customType: "regex",
            managerFilePatterns: [
                "/^\\.github/docker/.*/Dockerfile$/",
                "/^packaging/aur/.*\\.sh$/",
            ],
            matchStrings: [
                "cargo.*install (?<depName>\\S+)@(?<currentValue>\\S+)",
            ],
            depTypeTemplate: "build-dependencies",
            datasourceTemplate: "crate",
            versioningTemplate: "semver",
        },
        {
            description: "Track the sccache binary pinned via a renovate marker comment (the action pin does not cover it)",
            matchStringsStrategy: "any",
            customType: "regex",
            managerFilePatterns: [
                "/^\\.github/workflows/.*\\.yml$/",
                "/^\\.github/actions/.*/.*\\.yml$/",
            ],
            matchStrings: [
                "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+version:\\s*[\"']?(?<currentValue>v[0-9][^\"'\\s]*)[\"']?",
            ],
            depTypeTemplate: "sccache",
        },
        {
            description: "Track pinned shellcheck/shfmt binaries via renovate marker comments (per-arch checksums stay pinned in the script and fail closed until refreshed)",
            matchStringsStrategy: "any",
            customType: "regex",
            managerFilePatterns: [
                "/^packaging\\/aur\\/install-lint-tools\\.sh$/",
            ],
            matchStrings: [
                "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+\\w+_version=\"?(?<currentValue>v[0-9][^\"'\\s]*)\"?",
            ],
            depTypeTemplate: "build-dependencies",
        },
    ],
}
